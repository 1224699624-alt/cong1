outputs/**/nnUNet_raw/
outputs/**/nnUNet_preprocessed/
outputs/**/imagesVal/
outputs/**/imagesValPrior/

# Checkpoints and private/large medical data stay in the local backup.
checkpoints/*.pth
checkpoints/*.pt
data/raw/
data/raw_variants/
data/remote_variants/
data/yolo/
